{
  "$id": "https://absolutezro.local/schemas/sobedesce.relay-pedido.resposta.v1.json",
  "title": "SOBEDESCE relay.pedido: resposta v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pedidos": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
          },
          "preset": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              "convertendo",
              "pronto",
              "erro",
              "cancelado"
            ]
          },
          "frac": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "resultado": {
            "type": "object",
            "properties": {
              "arquivoId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,200}$"
              },
              "nome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "tamanho": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "md5": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "pastaId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,200}$"
              }
            },
            "required": [
              "arquivoId",
              "nome",
              "tamanho",
              "md5",
              "pastaId"
            ],
            "additionalProperties": false
          },
          "erro": {
            "type": "string",
            "maxLength": 300
          },
          "criado_em": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "preset",
          "ref",
          "status",
          "criado_em",
          "atualizado_em"
        ],
        "additionalProperties": false
      }
    },
    "computador": {
      "type": "object",
      "properties": {
        "aberto_agora": {
          "type": "boolean"
        },
        "usado_ha_pouco": {
          "type": "boolean"
        }
      },
      "required": [
        "aberto_agora",
        "usado_ha_pouco"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "pedidos",
    "computador"
  ],
  "additionalProperties": false
}
