{
  "$id": "https://absolutezro.local/schemas/zro.app-pedido.resposta.v1.json",
  "title": "Ponte entre apps: pedido assinado pelo HUB v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "const": "zro-pedido+jwt"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "aud": {
      "type": "string",
      "minLength": 1
    },
    "acao": {
      "type": "string",
      "enum": [
        "drive.listar",
        "drive.miniatura",
        "drive.pasta.criar",
        "drive.compartilhar_revisao",
        "drive.recolher_revisao",
        "drive.token"
      ]
    },
    "expira_em": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "tipo",
    "token",
    "aud",
    "acao",
    "expira_em",
    "url"
  ],
  "additionalProperties": false
}
