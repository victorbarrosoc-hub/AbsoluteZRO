{
  "$id": "https://absolutezro.local/schemas/carro-do-freela.job.v1.json",
  "title": "Job do Carro do Freela v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "carro-do-freela.job/1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "production_type": {
      "type": "string",
      "maxLength": 60
    },
    "client_reference": {
      "type": "string",
      "maxLength": 200
    },
    "briefing": {
      "type": "string",
      "maxLength": 20000
    },
    "city": {
      "type": "string",
      "maxLength": 120
    },
    "dates": {
      "default": [],
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "label": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "date"
        ]
      }
    },
    "crew_roles": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "maxLength": 80
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 200
          }
        },
        "required": [
          "role",
          "count"
        ]
      }
    },
    "references": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "contract",
    "job_id",
    "title"
  ]
}
