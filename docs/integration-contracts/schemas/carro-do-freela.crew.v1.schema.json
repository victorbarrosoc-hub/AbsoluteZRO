{
  "$id": "https://absolutezro.local/schemas/carro-do-freela.crew.v1.json",
  "title": "Equipe escalada num job do Carro do Freela v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "carro-do-freela.crew/1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "members": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zro_user_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "project_role": {
            "default": "viewer",
            "type": "string",
            "enum": [
              "editor",
              "viewer"
            ]
          }
        },
        "required": [
          "zro_user_id",
          "email",
          "function"
        ]
      }
    }
  },
  "required": [
    "contract",
    "job_id",
    "members"
  ]
}
