{
  "$id": "https://absolutezro.local/schemas/zro-media-manifest.v1.json",
  "title": "ZroMediaManifest v1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "source_app": {
      "type": "string",
      "enum": [
        "sobedesce",
        "manual"
      ]
    },
    "source_app_contract": {
      "type": "string",
      "maxLength": 80
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "production": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "day": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "n",
                "name",
                "date"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "camera": {
                  "type": "string",
                  "maxLength": 120
                },
                "folder": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "name",
                "camera",
                "folder"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_folder": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "production",
        "day",
        "owner",
        "card_folder"
      ]
    },
    "assets": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[A-Za-z0-9_-]{8,64}$"
          },
          "original_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "mime_detected": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "media": {
            "default": {},
            "type": "object",
            "properties": {
              "duration_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timecode_start": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{2}:\\d{2}:\\d{2}[:;]\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fps": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "card",
                  "folder",
                  "drive",
                  "manual"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "kind",
              "label"
            ]
          },
          "camera": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "card": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "checksums": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "xxh64",
                    "md5",
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                }
              },
              "required": [
                "algorithm",
                "value"
              ]
            }
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "destination_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "uri": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^zro-dest:\\/\\/[^\\s]+$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "unverified",
                    "verified",
                    "mismatch",
                    "missing",
                    "failed"
                  ]
                },
                "checksum": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "algorithm": {
                          "type": "string",
                          "enum": [
                            "xxh64",
                            "md5",
                            "sha256"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "pattern": "^[0-9a-f]+$"
                        }
                      },
                      "required": [
                        "algorithm",
                        "value"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verified_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 300
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "destination_id",
                "uri",
                "status",
                "checksum",
                "verified_at",
                "evidence"
              ]
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "required": [
          "asset_id",
          "original_name",
          "relative_path",
          "size_bytes",
          "mime_detected",
          "source",
          "camera",
          "card",
          "checksums",
          "destinations",
          "warnings"
        ]
      }
    },
    "copy_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "ok",
              "missing_files",
              "error",
              "canceled",
              "unknown"
            ]
          },
          "files_listed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "files_copied": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "bytes_copied": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "destination_id": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "maxLength": 200
                },
                "report_files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 255
                  }
                }
              },
              "required": [
                "destination_id",
                "label",
                "report_files"
              ]
            }
          },
          "source_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "operation_id",
          "started_at",
          "finished_at",
          "result",
          "files_listed",
          "files_copied",
          "bytes_copied",
          "destinations",
          "source_note"
        ]
      }
    },
    "verification_summary": {
      "type": "object",
      "properties": {
        "assets_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "destinations_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verified_locations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unverified_locations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mismatched_locations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_locations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fully_verified_assets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backup_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "assets_total",
        "destinations_total",
        "verified_locations",
        "unverified_locations",
        "mismatched_locations",
        "missing_locations",
        "fully_verified_assets",
        "backup_complete"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "manifest_id",
    "schema_version",
    "project_id",
    "source_app",
    "source_app_contract",
    "created_at",
    "job_id",
    "context",
    "assets",
    "copy_operations",
    "verification_summary",
    "warnings"
  ]
}
