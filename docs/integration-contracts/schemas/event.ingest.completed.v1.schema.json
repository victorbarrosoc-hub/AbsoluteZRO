{
  "$id": "https://absolutezro.local/schemas/event.ingest.completed.v1.json",
  "title": "Payload de ingest.completed v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest_row_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "manifest_id": {
      "type": "string"
    },
    "assets": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "valid_with_warnings",
        "invalid"
      ]
    }
  },
  "required": [
    "manifest_row_id",
    "manifest_id",
    "assets",
    "status"
  ]
}
