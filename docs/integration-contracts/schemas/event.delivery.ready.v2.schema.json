{
  "$id": "https://absolutezro.local/schemas/event.delivery.ready.v2.json",
  "title": "Payload de delivery.ready v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "finishing",
        "sobedesce"
      ]
    },
    "package_ref": {
      "type": "string",
      "maxLength": 300
    },
    "files": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checksum": {
      "type": "string",
      "const": "md5"
    },
    "verified": {
      "type": "boolean",
      "const": true
    },
    "folder_url": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https:\\/\\/drive\\.google\\.com\\/drive\\/(u\\/\\d+\\/)?folders\\/[\\w-]+(\\?[\\w=&.-]*)?$"
    }
  },
  "required": [
    "source",
    "package_ref",
    "files",
    "bytes",
    "checksum",
    "verified",
    "folder_url"
  ]
}
