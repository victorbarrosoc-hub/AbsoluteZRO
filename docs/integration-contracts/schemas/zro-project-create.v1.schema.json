{
  "$id": "https://absolutezro.local/schemas/zro-project-create.v1.json",
  "title": "Criar projeto v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "type": {
      "default": "outro",
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "client_reference": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "visibility": {
      "default": "organization",
      "type": "string",
      "enum": [
        "organization",
        "restricted"
      ]
    },
    "brief": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "external_links": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": [
          "label",
          "url"
        ]
      }
    }
  },
  "required": [
    "title"
  ]
}
