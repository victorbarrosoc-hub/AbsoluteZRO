{
  "$id": "https://absolutezro.local/schemas/zro.app-entrega.destinatarios.v1.json",
  "title": "Entrega entre apps: para quem dá para mandar v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "destinatarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "nome": {
            "type": "string",
            "maxLength": 120
          },
          "foto": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "eu": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "nome",
          "foto",
          "eu"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "destinatarios"
  ],
  "additionalProperties": false
}
