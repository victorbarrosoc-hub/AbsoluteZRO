{
  "$id": "https://absolutezro.local/schemas/zro-organization-plan.v1.json",
  "title": "Prévia de organização (Synquei) v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "dry_run": {
      "type": "boolean",
      "const": true
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "manifest_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "generator": {
      "type": "string"
    },
    "root_label": {
      "type": "string",
      "maxLength": 200
    },
    "create_folders": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "bins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bin": {
            "type": "string",
            "maxLength": 300
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "camera": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "bin",
          "asset_ids",
          "camera"
        ]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "keep_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "bin": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "asset_id",
          "keep_path",
          "bin"
        ]
      }
    },
    "moves": {
      "maxItems": 0,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "asset_id",
          "from",
          "to"
        ]
      }
    },
    "preserved_asset_ids": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "required": [
    "schema_version",
    "dry_run",
    "project_id",
    "manifest_id",
    "generated_at",
    "generator",
    "root_label",
    "create_folders",
    "bins",
    "assets",
    "moves",
    "preserved_asset_ids",
    "warnings"
  ]
}
