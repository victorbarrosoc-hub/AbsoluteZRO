{
  "$id": "https://absolutezro.local/schemas/synquei.preparo.v1.json",
  "title": "Recibo de preparo do Synquei v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formato": {
      "type": "string",
      "const": "synquei.preparo/1"
    },
    "op": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{6,100}$"
    },
    "app_versao": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "quando": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "estado": {
      "type": "string",
      "enum": [
        "recebido",
        "preparando",
        "preparado",
        "com_pendencias",
        "erro"
      ]
    },
    "resultado": {
      "type": "object",
      "properties": {
        "organizados": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sincronizados": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ignorados": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendentes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ausentes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "alterados": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "movidos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revisar": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "organizados",
        "sincronizados",
        "ignorados",
        "pendentes",
        "ausentes",
        "alterados",
        "movidos",
        "revisar"
      ],
      "additionalProperties": false
    },
    "exemplos": {
      "type": "object",
      "properties": {
        "ausentes": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "alterados": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "movidos": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "revisar": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": [
        "ausentes",
        "alterados",
        "movidos",
        "revisar"
      ],
      "additionalProperties": false
    },
    "repetido": {
      "type": "boolean"
    },
    "erro": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "formato",
    "op",
    "app_versao",
    "quando",
    "estado",
    "resultado",
    "exemplos"
  ],
  "additionalProperties": false
}
