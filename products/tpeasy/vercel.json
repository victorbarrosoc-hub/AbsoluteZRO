{
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/api/zro/ia/:caminho*",
      "destination": "/api/zro/ia?c=:caminho*"
    },
    {
      "source": "/api/zro/set/:caminho*",
      "destination": "/api/zro/set?c=:caminho*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
