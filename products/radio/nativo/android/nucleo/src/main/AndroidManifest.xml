<?xml version="1.0" encoding="utf-8"?>
<!-- O núcleo do rádio no Android: o serviço que mantém o rádio no ar com a tela travada. Quem usa (o app) pede as
     permissões em tempo de uso (microfone e notificações); estas entram no app pelo manifesto combinado. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="com.absolutezro.radio.nucleo.RadioNoAr"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone|mediaPlayback" />
    </application>
</manifest>
