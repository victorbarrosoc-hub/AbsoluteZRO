{
  "name": "radion-desktop",
  "productName": "RADION",
  "version": "0.1.0",
  "description": "RADION para computador: o rádio do set da Absolute ZRO no Mac e no Windows, com o atalho para falar, a barra de menus e o modo compacto.",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "Absolute ZRO",
  "homepage": "https://radion.absolutezro.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorbarrosoc-hub/AbsoluteZRO.git",
    "directory": "products/radio/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "desktop": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test test/*.test.mjs",
    "icones": "node scripts/icones.mjs",
    "compartilhado": "node scripts/compartilhado.mjs",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux dir --publish never",
    "bandeja": "node scripts/bandeja.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
