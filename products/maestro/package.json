{
  "name": "maestro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Maestro: pauta, aprovação do cliente e projetos para agências e produtoras, dentro do ecossistema Absolute ZRO.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "db:seed:demo": "tsx scripts/seed-demo.mts",
    "test": "tsx --test \"tests/*.test.mts\"",
    "test:e2e": "playwright test",
    "vercel-build": "tsx scripts/db-migrate.mts && next build"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.5",
    "drizzle-orm": "^0.45.3",
    "hls.js": "1.7.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
