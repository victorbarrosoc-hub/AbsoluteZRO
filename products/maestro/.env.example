# Copie para .env.local. Nada aqui é segredo de verdade; os valores reais ficam só nas variáveis da Vercel.

# Banco: Postgres com o schema `maestro` (Supabase AbsoluteZRO em produção; local em desenvolvimento).
# O papel que conecta é o dono do schema; o servidor assume `maestro_app` (sem login) em toda operação de usuário.
MAESTRO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/maestro
# MAESTRO_DATABASE_SCHEMA=maestro

# Chave de 32 bytes em base64 (openssl rand -base64 32): cifra os tokens da Absolute ZRO guardados na sessão e
# sela o cookie da ida ao login. Sem ela, fora de produção, vale uma chave fixa de desenvolvimento.
MAESTRO_KEY=

# Entrar com Absolute ZRO (login único, cliente confidencial `maestro-web`). Sem as duas, o botão não aparece.
ZRO_CLIENT_ID=
ZRO_CLIENT_SECRET=
# ZRO_ISSUER=https://absolutezro.com

# Endereço público deste site (retorno do login, links). Produção: https://maestro.absolutezro.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: chave de API do Google só do Maestro (autorizada pelo titular; restrita à Drive API e ao domínio do Maestro).
# Com ela, vídeo do Drive compartilhado como "qualquer pessoa com o link" toca num <video> com tempo automático; sem ela,
# o Drive toca pelo iframe e o comentário leva o tempo digitado. Nunca reutilize chave de outro app.
MAESTRO_GOOGLE_API_KEY=

# Calculadora de deslocamento: lugares (Photon) e km de carro (OSRM), do OpenStreetMap, ligados desde 29/10/2026 (o
# titular pediu o km medido sozinho); =0 desliga e os km voltam a ser só digitados. O preço do litro (ANP) é
# automático: vem da semana que o agendamento /api/cron/combustivel guarda (CRON_SECRET abaixo).
# MAESTRO_SERVICOS_ABERTOS=0
# Só teste: Photon e OSRM falsos (tests/rota-fixture.mts) e a página "últimas semanas pesquisadas" da ANP falsa
# (tests/anp-fixture.mts).
# MAESTRO_PHOTON_URL=
# MAESTRO_OSRM_URL=
# MAESTRO_ANP_URL=

# Drive pelo SOBEDESCE (Arquivos e o Drive na revisão; docs/integration-contracts/maestro-sobedesce.md).
# Segredo do Vercel Cron: desliga o "qualquer pessoa com o link" dos vídeos de revisão vencidos (/api/cron/revisao) e
# guarda a semana da ANP (/api/cron/combustivel). Sem ele, as rotas respondem 503 (revogar e fechar o lote continuam
# desligando na hora; a calculadora faz a coleta de reserva quando não há semana recente).
CRON_SECRET=
# Opcional: o app do SOBEDESCE para "Abrir no SOBEDESCE" (padrão https://sobedesce.com).
# MAESTRO_SOBEDESCE_URL=https://sobedesce.com
# Só teste: a ponte (HUB) falsa. Padrão: ZRO_ISSUER.
# MAESTRO_PONTE_URL=
