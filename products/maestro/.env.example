# Copie para .env.local. Nada aqui é segredo de verdade; os valores reais ficam só nas variáveis da Vercel.

# Banco: Postgres com o schema `maestro` (Supabase AbsoluteZRO em produção; local em desenvolvimento).
# O papel que conecta é o dono do schema; o servidor assume `maestro_app` (sem login) em toda operação de usuário.
MAESTRO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/maestro
# MAESTRO_DATABASE_SCHEMA=maestro

# Chave de 32 bytes em base64 (openssl rand -base64 32): cifra os tokens da Absolute ZRO guardados na sessão e
# sela o cookie da ida ao login. Sem ela, fora de produção, vale uma chave fixa de desenvolvimento.
MAESTRO_KEY=

# Entrar com Absolute ZRO (login único, cliente confidencial `maestro-web`). Sem as duas, o botão não aparece.
ZRO_CLIENT_ID=
ZRO_CLIENT_SECRET=
# ZRO_ISSUER=https://absolutezro.com

# Endereço público deste site (retorno do login, links). Produção: https://maestro.absolutezro.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: chave de API do Google só do Maestro (autorizada pelo titular; restrita à Drive API e ao domínio do Maestro).
# Com ela, vídeo do Drive compartilhado como "qualquer pessoa com o link" toca num <video> com tempo automático; sem ela,
# o Drive toca pelo iframe e o comentário leva o tempo digitado. Nunca reutilize chave de outro app.
MAESTRO_GOOGLE_API_KEY=
