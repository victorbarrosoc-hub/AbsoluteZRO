{
  "name": "maestro-desktop",
  "productName": "Maestro",
  "version": "0.2.1",
  "description": "Maestro para computador: a pauta, a aprovação do cliente e a produtora numa janela própria, no Mac e no Windows.",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "Absolute ZRO",
  "homepage": "https://maestro.absolutezro.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorbarrosoc-hub/AbsoluteZRO.git",
    "directory": "products/maestro/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "desktop": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test test/*.test.mjs",
    "icones": "node scripts/icones.mjs",
    "icones:bandeja": "node scripts/icones-bandeja.mjs",
    "compartilhado": "node scripts/compartilhado.mjs",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
