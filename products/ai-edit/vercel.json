{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run vendor && node scripts/publicar-site.mjs",
  "outputDirectory": "publico",
  "functions": {
    "api/app.js": {
      "includeFiles": "{app/**,src/**,presets/**,site/**,marca/**,em-desenvolvimento.html}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://absolutezro.com; worker-src 'self' blob:; connect-src 'self' blob: data: https://huggingface.co https://*.huggingface.co https://*.hf.co; media-src 'self' blob:; img-src 'self' blob: data: https://absolutezro.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/instalar.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/instalar.ps1",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/zro/set/:caminho*", "destination": "/api/zro/set?c=:caminho*" },
    { "source": "/app/:caminho*", "destination": "/api/app?caminho=app/:caminho*" },
    { "source": "/src/:caminho*", "destination": "/api/app?caminho=src/:caminho*" },
    { "source": "/presets/:caminho*", "destination": "/api/app?caminho=presets/:caminho*" },
    { "source": "/site/:caminho*", "destination": "/api/app?caminho=site/:caminho*" },
    { "source": "/marca/:caminho*", "destination": "/api/app?caminho=marca/:caminho*" },
    { "source": "/baixar/:sistema", "destination": "/api/baixar?sistema=:sistema" }
  ]
}
