# Copie para .env.local. Sem SOBEDESCE_DATABASE_URL nem DATABASE_URL o site usa o PGlite em ./data/pglite.
# Produção: Supabase da Absolute ZRO (pooler de transação, 6543) + schema. Veja docs/CONTAS.md §2.1.
SOBEDESCE_DATABASE_URL=
# SOBEDESCE_DATABASE_SCHEMA=sobedesce
# Só na virada: endereço do Neon, origem da cópia (scripts/copiar-do-neon.mts).
# SOBEDESCE_COPIAR_DE=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
SOBEDESCE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E-mail transacional (Resend). Sem chave: em dev o e-mail aparece no console; em produção "Esqueci a senha" fica indisponível.
RESEND_API_KEY=
EMAIL_REMETENTE=SOBEDESCE <nao-responda@dissesim.com.br>
# Entrar com Absolute ZRO (login único). Sem estas duas, o botão não aparece.
ZRO_CLIENT_ID=
ZRO_CLIENT_SECRET=
# ZRO_ISSUER=https://absolutezro.com
