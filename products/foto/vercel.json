{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev --no-audit --no-fund",
  "buildCommand": "node publicar.mjs",
  "outputDirectory": "publico",
  "cleanUrls": true,
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/pagina.js": {
      "includeFiles": "{app/**,src/**}"
    },
    "api/recurso.js": {
      "includeFiles": "{app/**,src/**}"
    },
    "api/galeria.js": {
      "includeFiles": "{galeria/**,app/indisponivel.html}"
    },
    "api/evento.js": {
      "includeFiles": "{evento/**,app/indisponivel.html,app/rosto/**,app/trabalho/servir.js,src/rosto/**}"
    },
    "api/link/evento.js": {
      "includeFiles": "src/rosto/**"
    },
    "api/foto/eventos.js": {
      "includeFiles": "src/rosto/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/zro/set/:caminho*",
      "destination": "/api/zro/set?c=:caminho*"
    },
    {
      "source": "/",
      "destination": "/api/pagina"
    },
    {
      "source": "/entrar",
      "destination": "/api/zro/entrar"
    },
    {
      "source": "/app/:f*",
      "destination": "/api/recurso?pasta=app&f=:f*"
    },
    {
      "source": "/src/:f*",
      "destination": "/api/recurso?pasta=src&f=:f*"
    },
    {
      "source": "/api/foto/galerias/:id/:acao",
      "destination": "/api/foto/galerias?id=:id&acao=:acao"
    },
    {
      "source": "/api/foto/galerias/:id",
      "destination": "/api/foto/galerias?id=:id"
    },
    {
      "source": "/api/foto/predefinicoes/:id",
      "destination": "/api/foto/predefinicoes?id=:id"
    },
    {
      "source": "/api/link/:acao",
      "destination": "/api/link/porta?acao=:acao"
    },
    {
      "source": "/g/:token/i/:foto",
      "destination": "/api/link/porta?acao=imagem&t=:token&f=:foto"
    },
    {
      "source": "/g/:token/:arquivo",
      "destination": "/api/galeria?t=:token&f=:arquivo"
    },
    {
      "source": "/g/:token",
      "destination": "/api/galeria?t=:token"
    },
    {
      "source": "/api/foto/eventos/:id/:acao",
      "destination": "/api/foto/eventos?id=:id&acao=:acao"
    },
    {
      "source": "/api/foto/eventos/:id",
      "destination": "/api/foto/eventos?id=:id"
    },
    {
      "source": "/api/evento/:acao",
      "destination": "/api/link/evento?acao=:acao"
    },
    {
      "source": "/e/:token/i/:foto",
      "destination": "/api/link/evento?acao=imagem&t=:token&f=:foto"
    },
    {
      "source": "/e/:token/app/:pasta/:arquivo",
      "destination": "/api/evento?t=:token&d=app-:pasta&f=:arquivo"
    },
    {
      "source": "/e/:token/src/:pasta/:arquivo",
      "destination": "/api/evento?t=:token&d=src-:pasta&f=:arquivo"
    },
    {
      "source": "/e/:token/:arquivo",
      "destination": "/api/evento?t=:token&f=:arquivo"
    },
    {
      "source": "/e/:token",
      "destination": "/api/evento?t=:token"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' blob: data: https://absolutezro.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://absolutezro.com; worker-src 'self' blob:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/e/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(fontes|vendor|modelos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
