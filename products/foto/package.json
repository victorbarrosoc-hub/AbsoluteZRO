{
  "name": "foto",
  "version": "0.1.0",
  "description": "Plataforma de fotos da Absolute ZRO: decupagem, revelação RAW e predefinições, no aparelho. ADR 0044.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node publicar.mjs && FOTO_LOCAL=1 node scripts/servir.mjs",
    "build": "node publicar.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "migrar": "node scripts/migrar.mjs",
    "vendor": "node scripts/vendor.mjs",
    "modelos": "node scripts/modelos.mjs",
    "marca": "node scripts/marca.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@colorhythm/libraw-wasm": "1.1.1",
    "htm": "3.1.1",
    "playwright": "1.63.0",
    "preact": "10.27.2"
  }
}
