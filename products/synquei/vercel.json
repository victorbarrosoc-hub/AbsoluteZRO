{
  "regions": [
    "gru1"
  ],
  "framework": null,
  "installCommand": "echo sem dependências para o site",
  "buildCommand": "echo sem build",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/instalar.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/instalar.ps1",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/api/zro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/zro/ia/:caminho*",
      "destination": "/api/zro/ia?c=:caminho*"
    },
    {
      "source": "/api/zro/set/:caminho*",
      "destination": "/api/zro/set?c=:caminho*"
    },
    {
      "source": "/baixar/versao",
      "destination": "/api/baixar?p=versao"
    },
    {
      "source": "/baixar/:p",
      "destination": "/api/baixar?p=:p"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "synquei.vercel.app"
        }
      ],
      "destination": "https://synquei.absolutezro.com/",
      "permanent": true
    },
    {
      "source": "/:caminho((?!app(?:/|$)|sw\\.js$|api/|baixar/|icons/|manifest|favicon).*)",
      "has": [
        {
          "type": "host",
          "value": "synquei.vercel.app"
        }
      ],
      "destination": "https://synquei.absolutezro.com/:caminho",
      "permanent": true
    },
    {
      "source": "/instalar.sh",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "https://absolutezro.com/baixar",
      "permanent": false
    },
    {
      "source": "/instalar.ps1",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "https://absolutezro.com/baixar",
      "permanent": false
    }
  ]
}
