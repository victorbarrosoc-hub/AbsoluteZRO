# Supabase project: URL + PUBLIC anon/publishable key. These can also use NEXT_PUBLIC_ aliases.
# Configure the site's Auth URL and redirect allowlist in the Supabase dashboard.
SUPABASE_URL=https://projeto-novo-substituir.supabase.co
SUPABASE_ANON_KEY=
# Server-only administrative key for private restoration jobs/storage; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional until the GPU worker is deployed; automatic restoration uses D, never a hidden local fallback.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# >=32 characters, used by the daily private-storage cleanup endpoint.
CRON_SECRET=
# Stripe subscriptions; leave empty to keep manual plan activation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stable PRIVATE encryption/signing secret, at least 32 random characters recommended.
# Existing installations may keep NOSSOM_AI_ACCESS_CODE as a legacy server-only fallback.
NOSSOM_AUTH_SECRET=
NOSSOM_AI_ACCESS_CODE=

# Shared platform Anthropic credentials. NEVER prefix API keys with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional overrides; the server already defaults to the owner's registered agent/environment.
ANTHROPIC_AGENT_ID=agent_01MwL58EV86EVa1QtnRoJJFN
ANTHROPIC_ENVIRONMENT_ID=env_01XJjWsz3E3nym6SNC7ZbtsM

# Optional PUBLIC ElevenLabs Conversational AI agent, shared by the platform.
# Restrict allowed domains and spending in the ElevenLabs dashboard.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Optional PUBLIC HTTPS URLs of actual approved desktop installers, read at build time.
# Keep empty until the real files are published. Private GitHub artifact links do not work publicly.
NOSSOM_DOWNLOAD_MAC_ARM64_URL=
NOSSOM_DOWNLOAD_MAC_X64_URL=
NOSSOM_DOWNLOAD_WINDOWS_URL=
