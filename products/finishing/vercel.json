{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo sem dependências para o site",
  "buildCommand": "node scripts/publicar-site.mjs",
  "outputDirectory": "publico",
  "cleanUrls": true,
  "functions": {
    "api/app.js": {
      "includeFiles": "{inicio.html,lut.html,lab.html,looks.html,cst.html,entrega.html,converter.html,em-desenvolvimento.html,app/**,src/**,exemplos/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' blob: data: https://absolutezro.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' https://absolutezro.com; worker-src 'self' blob:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/inicio", "destination": "/api/app?caminho=inicio.html" },
    { "source": "/lut", "destination": "/api/app?caminho=lut.html" },
    { "source": "/lab", "destination": "/api/app?caminho=lab.html" },
    { "source": "/looks", "destination": "/api/app?caminho=looks.html" },
    { "source": "/cst", "destination": "/api/app?caminho=cst.html" },
    { "source": "/entrega", "destination": "/api/app?caminho=entrega.html" },
    { "source": "/converter", "destination": "/api/app?caminho=converter.html" },
    { "source": "/app/:caminho*", "destination": "/api/app?caminho=app/:caminho*" },
    { "source": "/src/:caminho*", "destination": "/api/app?caminho=src/:caminho*" },
    { "source": "/exemplos/:caminho*", "destination": "/api/app?caminho=exemplos/:caminho*" }
  ],
  "redirects": [
    {
      "source": "/:caminho*",
      "has": [
        {
          "type": "host",
          "value": "revela-zro.vercel.app"
        }
      ],
      "destination": "https://revela.absolutezro.com/:caminho*",
      "permanent": true
    }
  ]
}
