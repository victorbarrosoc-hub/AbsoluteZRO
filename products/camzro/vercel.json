{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev --no-audit --no-fund",
  "buildCommand": "node publicar.mjs",
  "outputDirectory": "publico",
  "cleanUrls": true,
  "regions": ["gru1"],
  "functions": {
    "api/pagina.js": { "includeFiles": "app/**" },
    "api/recurso.js": { "includeFiles": "app/**" },
    "api/previa.js": { "includeFiles": "app/indisponivel.html" }
  },
  "rewrites": [
    { "source": "/api/zro/set/:caminho*", "destination": "/api/zro/set?c=:caminho*" },
    { "source": "/", "destination": "/api/pagina" },
    { "source": "/previa", "destination": "/api/previa" },
    { "source": "/sobre", "destination": "/api/pagina?v=sobre" },
    { "source": "/entrar", "destination": "/api/zro/entrar" },
    { "source": "/sw.js", "destination": "/api/recurso?f=sw.js" },
    { "source": "/app/:f*", "destination": "/api/recurso?f=:f*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), screen-wake-lock=(self), fullscreen=(self), accelerometer=(self), gyroscope=(self), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob: https://absolutezro.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://absolutezro.com; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    { "source": "/fontes/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
