{
  "name": "zera-desktop",
  "productName": "ZERA",
  "version": "0.1.0",
  "description": "ZERA: mostra o que ocupa o disco e libera espaço com segurança, no Mac e no Windows. Da Absolute ZRO.",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "Absolute ZRO",
  "homepage": "https://zera.absolutezro.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorbarrosoc-hub/AbsoluteZRO.git",
    "directory": "products/zera/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "motor": "cargo build --release --manifest-path ../motor/Cargo.toml",
    "desktop": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test test/*.test.mjs",
    "telas": "node scripts/telas.mjs",
    "site-imagens": "node scripts/site-imagens.mjs",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  }
}
