# Absolute ZRO HUB — variáveis de ambiente. Copie para apps/hub-web/.env.local (dev) ou configure no provedor.
# Nunca commite valores reais. Nunca reutilize chaves, bancos ou segredos dos apps originais.

# Ambiente: development | staging | production. Em production: HSTS, cookie Secure, seed demo bloqueado,
# e-mail sem provedor = indisponível (nada é fingido).
ZRO_ENV=development

# Banco NOVO do HUB (Postgres 15+; recomendado: projeto Supabase novo, só o Postgres). O usuário precisa poder
# criar o papel zro_app na primeira migration (no Supabase: postgres).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zro_dev
# Pooler em modo transação (Supabase porta 6543) não aceita prepared statements: use false.
DATABASE_PREPARE=true
DATABASE_POOL_MAX=10

# Origem pública do HUB (links de e-mail e checagem de origem das mutações) e origens extras aceitas.
ZRO_APP_ORIGIN=http://localhost:3000
# Entrar com o Google (opcional; sem os dois, o botão não aparece). Retorno: <origem>/entrar/google/retorno
# Cliente "Absolute ZRO – central" (Google Cloud do ecossistema): Entrar com Google e Conexões.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Conexões (ADR 0026): chave dos tokens do Google Agenda, 32 bytes (openssl rand -base64 32). Sem ela, Conexões
# fica "indisponível" (nunca guarda token em claro). Retorno no Google: <origem>/conexoes/google/retorno
ZRO_CONEXOES_KEY=
ZRO_ALLOWED_ORIGINS=

# Segredo para transformar IP em hash não reversível nos logs e limites de tentativa (openssl rand -hex 32).
# Vazio = o IP não é guardado.
ZRO_IP_HASH_SECRET=

# Sessão: horas sem uso até expirar e duração máxima em dias.
ZRO_SESSION_IDLE_HOURS=72
ZRO_SESSION_MAX_DAYS=14

# Cobrança pelo Stripe (ADR 0019). Sem as duas chaves, a venda online fica fechada e os pedidos vão para a equipe.
# Webhook no Stripe: https://<domínio>/api/v1/billing/webhooks/stripe, eventos customer.subscription.*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Outros provedores pelo contrato neutro (ex.: manual): liste o provedor e defina o segredo dele.
# Ex.: ZRO_BILLING_PROVIDERS=manual e ZRO_BILLING_WEBHOOK_SECRET_MANUAL=<segredo forte>
ZRO_BILLING_PROVIDERS=
ZRO_BILLING_WEBHOOK_SECRET_MANUAL=

# Agendamentos da Vercel (apps/hub-web/vercel.json): GET /api/cron/dolar busca o dólar do Banco Central para os Custos.
# Sem ele, a rota responde 503 e só a página dos Custos atualiza (quando a busca passou de 24 h).
CRON_SECRET=
# Só teste: o Banco Central falso (padrão: https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata).
# ZRO_PTAX_URL=

# A Z, a IA do ecossistema (Claude). Sem a chave, a Z fica "desligada" e o Laboratório da Z mostra "Conecte a chave".
IA_ANTHROPIC_KEY=
# Modelo da Z (padrão: claude-opus-5-5).
IA_MODELO=
# Laboratório da Z (ADR 0033, só o admin da plataforma): voz, ditado e transcrição pela ElevenLabs. Só no servidor;
# o navegador recebe um token de uso único para a escuta ao vivo. Sem ela, o laboratório mostra "Conecte a chave".
ELEVENLABS_API_KEY=
# Só teste: o Claude e a ElevenLabs falsos do e2e (tests/fixtures/z-lab-falso.ts). Nunca em produção.
# ZRO_ANTHROPIC_URL=
# ZRO_ELEVENLABS_URL=
# ZRO_ELEVENLABS_WS_URL=

# Worker da fila
ZRO_WORKER_IDLE_MS=2000
ZRO_WORKER_LEASE_MS=600000

# Seed de demonstração (só fora de produção)
ZRO_DEMO_PASSWORD=

LOG_LEVEL=info

# Absolute ZRO para computador: "1" libera o download do .dmg/.exe em /baixar. Sem isso, "Em breve".
HUB_DESKTOP_PUBLICO=
