# Absolute ZRO HUB — variáveis de ambiente. Copie para apps/hub-web/.env.local (dev) ou configure no provedor.
# Nunca commite valores reais. Nunca reutilize chaves, bancos ou segredos dos apps originais.

# Ambiente: development | staging | production. Em production: HSTS, cookie Secure, seed demo bloqueado,
# e-mail sem provedor = indisponível (nada é fingido).
ZRO_ENV=development

# Banco NOVO do HUB (Postgres 15+; recomendado: projeto Supabase novo, só o Postgres). O usuário precisa poder
# criar o papel zro_app na primeira migration (no Supabase: postgres).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zro_dev
# Pooler em modo transação (Supabase porta 6543) não aceita prepared statements: use false.
DATABASE_PREPARE=true
DATABASE_POOL_MAX=10

# Origem pública do HUB (links de e-mail e checagem de origem das mutações) e origens extras aceitas.
ZRO_APP_ORIGIN=http://localhost:3000
# Entrar com o Google (opcional; sem os dois, o botão não aparece). Retorno: <origem>/entrar/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZRO_ALLOWED_ORIGINS=

# Segredo para transformar IP em hash não reversível nos logs e limites de tentativa (openssl rand -hex 32).
# Vazio = o IP não é guardado.
ZRO_IP_HASH_SECRET=

# Sessão: horas sem uso até expirar e duração máxima em dias.
ZRO_SESSION_IDLE_HOURS=72
ZRO_SESSION_MAX_DAYS=14

# Cobrança: provedor ainda não escolhido. Para habilitar um webhook, liste o provedor e defina o segredo dele.
# Ex.: ZRO_BILLING_PROVIDERS=manual e ZRO_BILLING_WEBHOOK_SECRET_MANUAL=<segredo forte>
ZRO_BILLING_PROVIDERS=
ZRO_BILLING_WEBHOOK_SECRET_MANUAL=

# Worker da fila
ZRO_WORKER_IDLE_MS=2000
ZRO_WORKER_LEASE_MS=600000

# Seed de demonstração (só fora de produção)
ZRO_DEMO_PASSWORD=

LOG_LEVEL=info

# Absolute ZRO para computador: "1" libera o download do .dmg/.exe em /baixar. Sem isso, "Em breve".
HUB_DESKTOP_PUBLICO=
